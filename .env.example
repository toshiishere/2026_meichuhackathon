WEB_PORT=8080
DATA_PATH=./data
# Set to `git rev-parse HEAD` when launching without Make.
PROJECT_GIT_COMMIT=unknown

# IPv4 address or DNS hostname reachable from the phone; no scheme or port.
PHONE_HOST=192.168.1.50
PHONE_HTTPS_PORT=8443
PHONE_CERT_PORT=8081
PHONE_BIND_IP=0.0.0.0
PHONE_TLS_PATH=./data/app/phone_tls

# Discord alert bot, started by make up. Create the bot at
# https://discord.com/developers/applications, invite it to the server, and put
# its token here; the channel defaults to the one in dc_bot/alert.py.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Training container (started by make up): Radeon 840M/860M architecture on this machine.
ROCM_GPU=gfx1152

# Licensed Ryzen AI 1.8 virtual environment mounted read-only by npu-service.
RYZEN_AI_PATH=./ryzen_ai-1.8.0/.venv
